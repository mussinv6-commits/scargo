# SCARGO 백엔드 환경변수 예시 (application.yml 이 읽음). 실제 비밀번호를 이 파일에 적어 공유하지 마세요
# PowerShell
$env:SCARGO_DB_URL = "jdbc:postgresql://localhost:5432/scargo"
$env:SCARGO_DB_USERNAME = "postgres"
$env:SCARGO_DB_PASSWORD = "<로컬 PostgreSQL 비밀번호>"
# Git Bash / macOS / Linux
# export SCARGO_DB_URL=jdbc:postgresql://localhost:5432/scargo
# export SCARGO_DB_USERNAME=postgres
# export SCARGO_DB_PASSWORD='<로컬 PostgreSQL 비밀번호>'
