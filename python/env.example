# SCARGO OCR 서버 환경변수 예시 (PowerShell). 값은 각자 PC 에 맞게 — 이 파일에 실제 비밀번호를 적어 공유하지 마세요
$env:PGHOST = "localhost"
$env:PGPORT = "5432"
$env:PGDATABASE = "scargo"        # 새로 설치한 시연 DB (작업 DB 이름을 넣지 말 것)
$env:PGUSER = "postgres"
$env:PGPASSWORD = "<로컬 PostgreSQL 비밀번호>"
$env:GATE_API_ID = "admin"              # 백엔드 AdminInitializer 가 만드는 시연 관리자 계정 (README 9장)
$env:GATE_API_PW = "<시연 관리자 비밀번호>"
