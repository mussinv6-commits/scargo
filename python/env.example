# SCARGO OCR 서버(gate_api.py) 환경변수 예시. 값은 각자 PC 에 맞게 - 이 파일에 실제 비밀번호·토큰을 적어 공유하지 마세요
# 아래 네 개(PGPASSWORD, GATE_API_ID, GATE_API_PW, GATE_API_TOKEN)는 필수입니다. 기본값이 없어서 없으면 서버가 시작하지 않습니다.

# ---- 그 창에서만 쓰기 (PowerShell) ----
$env:PGHOST = "localhost"
$env:PGPORT = "5432"
$env:PGDATABASE = "scargo"        # 새로 설치한 시연 DB (작업 DB 이름을 넣지 말 것)
$env:PGUSER = "postgres"
$env:PGPASSWORD = "<로컬 PostgreSQL 비밀번호>"
$env:GATE_API_ID = "<시연 관리자 아이디>"              # 백엔드 AdminInitializer 가 만드는 시연 관리자 계정 (README 9장)
$env:GATE_API_PW = "<시연 관리자 비밀번호>"
$env:GATE_API_TOKEN = "<임의의 긴 문자열>"             # /scan, /hub/scan 호출 때 X-Gate-Token 헤더로 보내는 값. 백엔드·프론트도 같은 값 사용
# $env:GATE_API_HOST = "127.0.0.1"                    # 기본값. 다른 PC 에서 붙어야 할 때만 0.0.0.0 (이때는 방화벽·토큰 관리 주의)

# ---- 한 번만 등록 (PowerShell, 이후 새로 연 창·런처에서 계속 적용) ----
# 위 값을 아래 형태로 한 번씩 실행한 뒤 런처·터미널을 모두 닫았다가 다시 여세요
# [Environment]::SetEnvironmentVariable("PGPASSWORD", "<로컬 PostgreSQL 비밀번호>", "User")
# [Environment]::SetEnvironmentVariable("GATE_API_ID", "<시연 관리자 아이디>", "User")
# [Environment]::SetEnvironmentVariable("GATE_API_PW", "<시연 관리자 비밀번호>", "User")
# [Environment]::SetEnvironmentVariable("GATE_API_TOKEN", "<임의의 긴 문자열>", "User")

# ---- 프론트(frontend/.env.local) 에는 같은 토큰을 VITE_GATE_API_TOKEN 으로 넣습니다 (frontend/.env.example 참고) ----
